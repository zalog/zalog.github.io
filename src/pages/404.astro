---
import Base from '../layouts/Base.astro';
---

<Base lang="en" title="Page not found · zalog.ro" description="This page does not exist." noindex>
  <main id="main" class="layer gutter">
    <div class="mx-auto flex min-h-[80svh] max-w-5xl flex-col justify-center gap-6 py-20">
      <p class="font-mono text-sm text-muted">404</p>
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-6xl">This page does not exist.</h1>
      <p class="text-lg text-muted" lang="ro">Pagina aceasta nu există.</p>
      <p class="flex flex-wrap gap-3 font-mono text-sm">
        <a class="bracket" href="/en/">Go to the homepage</a>
        <a class="bracket" href="/" lang="ro">Mergi la prima pagină</a>
      </p>
    </div>
  </main>
</Base>
