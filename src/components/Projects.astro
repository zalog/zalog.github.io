---
import { earlier, recent, type Lang } from '../data/content';
import { pick, slug, useT } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const years = [...new Set(earlier.map((s) => s.year))].sort((a, b) => b - a);
const sites = years.flatMap((year) => earlier.filter((s) => s.year === year));

const counts = new Map<string, number>();
earlier.forEach((s) => s.skills.forEach((k) => counts.set(k, (counts.get(k) ?? 0) + 1)));
const techs = [...counts].filter(([, n]) => n >= 3).sort((a, b) => b[1] - a[1]).map(([k]) => k);

const highlights = earlier.filter((s) => s.featured).map((s) => s.name);
---

<section id="projects" class="scroll-mt-24" aria-labelledby="projects-title">
  <h2 id="projects-title" class="mb-6 text-2xl font-semibold tracking-tight">{t('projectsTitle')}</h2>

  <ul class="border-t border-line">
    {
      recent.map((r) => (
        <li id={`proj-${r.id}`} class="reveal row grid gap-x-8 gap-y-1 border-b border-line py-5 sm:grid-cols-[8rem_1fr]">
          <p class="font-mono text-sm text-muted tabular-nums sm:pt-1">{r.year}</p>
          <div class="min-w-0">
            <h3 class="text-lg font-semibold">
              {r.href ? (
                <a class="inline-flex items-baseline gap-2 hover:text-accent" href={r.href} target="_blank" rel="noopener">
                  {pick(r.name, lang)}
                  <span class="sr-only"> {t('newTab')}</span>
                  <span class="row-arrow text-base text-muted" aria-hidden="true">↗</span>
                </a>
              ) : (
                pick(r.name, lang)
              )}
            </h3>
            <p class="font-mono text-xs text-muted">{r.client[lang]}</p>
            <p class="mt-2 max-w-[38rem]">{r.text[lang]}</p>
            <p class="mt-2 font-mono text-xs text-muted">{r.stack.join(' · ')}</p>
          </div>
        </li>
      ))
    }
    {/* .reveal is on the text, not the row: the list below makes the row taller, which rewinds its scroll animation */}
    <li class="grid gap-x-8 gap-y-1 py-5 sm:grid-cols-[8rem_1fr]">
      <p class="reveal font-mono text-sm text-muted tabular-nums sm:pt-1">{years.at(-1)} – {years[0]}</p>
      <div class="reveal min-w-0">
        <h3 class="text-lg font-semibold">{t('archiveTitle')}</h3>
        <p class="mt-2 max-w-[38rem]">{t('archiveIntro', { sites: highlights.join(', ') })}</p>
      </div>
      <details id="archive" class="group sm:col-span-2">
        <summary class="bracket mt-4 font-mono text-sm sm:ml-40">
          <span class="group-open:hidden">{t('viewMore')}</span>
          <span class="hidden group-open:inline">{t('viewLess')}</span>
          <span class="caret inline-block" aria-hidden="true">›</span>
        </summary>
          <p class="mt-5 flex flex-wrap gap-x-2 gap-y-1 font-mono text-xs text-muted sm:ml-40" role="group" aria-label={t('filterLabel')} data-filter data-shown={t('shown', { n: '{n}' })} data-shown-other={t('shownOther', { n: '{n}' })}>
            {
              ['all', ...techs].map((k, i) => (
                <>
                  {i > 0 && <span aria-hidden="true">·</span>}
                  <button type="button" class="underline-offset-4 hover:text-fg aria-pressed:text-fg aria-pressed:underline aria-pressed:decoration-2" data-tech={k} aria-pressed="false">
                    {k === 'all' ? t('all') : k} {k === 'all' ? earlier.length : counts.get(k)}
                  </button>
                </>
              ))
            }
            <span class="sr-only" role="status" aria-live="polite" data-status></span>
          </p>
        <ul class="mt-5 border-t border-line" data-ledger>
          {
            sites.map((s) => (
              <li id={`site-${slug(s.name)}`} class="reveal row grid gap-x-8 gap-y-1 border-b border-line py-5 sm:grid-cols-[8rem_1fr] [&:not(:has(~li:not([hidden])))]:border-b-0" data-skills={s.skills.join(',')}>
                <p class="font-mono text-sm text-muted tabular-nums sm:pt-1">{s.year}</p>
                <div class="min-w-0">
                  <h4 class="text-lg font-semibold break-words">
                    {s.href ? (
                      <a class="inline-flex items-baseline gap-2 hover:text-accent" href={s.href} target="_blank" rel="noopener">
                        {s.name}
                        <span class="sr-only"> {t('newTab')}</span>
                        <span class="row-arrow text-base text-muted" aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      s.name
                    )}
                  </h4>
                  <p class="font-mono text-xs text-muted">{[s.about[lang], !s.href && t('noLink')].filter(Boolean).join(' · ')}</p>
                  <p class="mt-2 font-mono text-xs text-muted break-words">{s.skills.join(' · ')}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </details>
    </li>
  </ul>
</section>

<script>
  const box = document.querySelector<HTMLElement>('[data-filter]');
  const archive = document.querySelector<HTMLDetailsElement>('#archive');
  if (box && archive) {
    const rows = document.querySelectorAll<HTMLElement>('[data-ledger] li[data-skills]');
    const tags = box.querySelectorAll<HTMLButtonElement>('[data-tech]');
    const plural = new Intl.PluralRules(document.documentElement.lang);
    const apply = (tech: string | null) => {
      let shown = 0;
      rows.forEach((li) => {
        const match = !tech || tech === 'all' || (li.dataset.skills ?? '').split(',').includes(tech);
        li.hidden = !match;
        if (match) shown++;
      });
      tags.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tech === tech)));
      const status = box.querySelector('[data-status]');
      // Romanian puts "de" before 20 or more ("53 de proiecte"): the `other` plural form
      const text = plural.select(shown) === 'other' ? box.dataset.shownOther : box.dataset.shown;
      if (status) status.textContent = tech ? (text ?? '').replace('{n}', String(shown)) : '';
    };
    box.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('[data-tech]');
      if (b) apply(b.getAttribute('aria-pressed') === 'true' ? null : (b.dataset.tech ?? 'all'));
    });
    archive.addEventListener('toggle', () => {
      if (!archive.open) apply(null);
    });
  }
</script>
