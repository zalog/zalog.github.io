---
import { profile, social, type Lang } from '../data/content';
import { useT } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<section id="contact" class="scroll-mt-24" aria-labelledby="contact-title">
  <h2 id="contact-title" class="mb-2 text-2xl font-semibold tracking-tight">{t('contactTitle')}</h2>
  <p class="mb-6 max-w-[38rem] text-muted">{t('contactLead')}</p>
  <div class="grid gap-8 sm:grid-cols-2">
    <div>
      <p class="mb-1 font-mono text-xs text-muted">{t('phone')}</p>
      <p class="flex flex-wrap items-center gap-3">
        <a id="phone" class="text-xl font-semibold tabular-nums" href={`tel:${profile.phone.e164}`}>{profile.phone.shown}</a>
        <slot name="phone-actions" />
      </p>
    </div>
    <div class="min-w-0">
      <p class="mb-1 font-mono text-xs text-muted">{t('elsewhere')}</p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        {
          social.map((s) => (
            <li>
              <a class="underline decoration-line decoration-1 underline-offset-4 hover:decoration-fg" href={s.href} target="_blank" rel="noopener me">
                {s.label}
                <span class="sr-only"> {t('newTab')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
